[app]
title = Tic Tac Toe
package.name = tictactoe
package.domain = org.irfan
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
p4a.branch = master
bootloader = default

[buildozer]
log_level = 2
warn_on_root = 1
